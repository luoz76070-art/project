# ============================================================================
# 数据库配置（v2.2+：MySQL 替代 SQLite）
# ============================================================================
# 选项 1：使用 MySQL（推荐用于生产/多用户场景）
# 连接宿主机的 luozhe-mysql 容器（network_mode: host）
DATABASE_URL="mysql://root:MyRoot@2024@127.0.0.1:3306/library-data"

# 选项 2：使用 SQLite（适合单机演示 / 个人使用）
# 如需切回 SQLite，修改 DATABASE_URL 并改 docker-compose.yml 的 network_mode
# DATABASE_URL="file:/app/data/library.db"

# ============================================================================
# NextAuth 认证
# ============================================================================
NEXTAUTH_SECRET="dev-secret-please-change-in-production-environment-xyz123"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-please-change-in-production-environment-xyz123"
AUTH_TRUST_HOST="true"

# ============================================================================
# AI Agent（可选，未启用留空）
# ============================================================================
AI_PROVIDER_API_KEY=""
AI_PROVIDER_BASE_URL="https://api.MiniMax.com/v1"
AI_MODEL="MiniMax-M2"