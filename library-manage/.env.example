# ============================================================================
# 数据库配置（MySQL）
# ============================================================================
# 默认 root 凭据已移除。多用户共用 root 会导致数据互相污染、seed 冲突、
# 无法隔离调试。详见 docs/DATABASE.md。
#
# 替换占位符为你的个人账户：
DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/library-data"

# ============================================================================
# NextAuth 认证
# ============================================================================
NEXTAUTH_SECRET="dev-secret-please-change-in-production-environment-xyz123"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-please-change-in-production-environment-xyz123"
AUTH_TRUST_HOST="true"