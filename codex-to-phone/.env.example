# Local Relay
MOBILE_CODEX_HOST=127.0.0.1
MOBILE_CODEX_PORT=8787
MOBILE_CODEX_TOKEN=change-me-use-a-long-random-token
CODEX_HOME=$HOME/.codex
MOBILE_CODEX_DEFAULT_CWD=<PROJECT_ROOT>
MOBILE_CODEX_DDNS_DOMAIN=

# Public Broker
MOBILE_CODEX_BROKER_HOST=127.0.0.1
MOBILE_CODEX_BROKER_PORT=18888
MOBILE_CODEX_BROKER_RELAYS={"my-mac":"replace-with-at-least-24-random-characters"}
MOBILE_CODEX_BROKER_URL=https://broker.example.com
MOBILE_CODEX_RELAY_ID=my-mac
MOBILE_CODEX_RELAY_SECRET=replace-with-the-same-secret-as-the-broker
MOBILE_CODEX_LOCAL_RELAY=http://127.0.0.1:8787

# Android build-time update source. Leave empty to disable update checks.
VITE_MOBILE_CODEX_UPDATE_MANIFEST_URL=https://downloads.example.com/mobile-codex/android/latest.json

# Optional self-hosted APK publishing
MOBILE_CODEX_RELEASE_HOST=deploy@example.com
MOBILE_CODEX_RELEASE_SSH_KEY=$HOME/.ssh/id_ed25519
MOBILE_CODEX_RELEASE_DIR=/var/www/mobile-codex/releases/android
MOBILE_CODEX_RELEASE_BASE_URL=https://downloads.example.com/mobile-codex/android
