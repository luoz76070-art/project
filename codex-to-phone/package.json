{
  "name": "mobile-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @mobile-codex/relay --filter @mobile-codex/mobile dev",
    "dev:relay": "pnpm --filter @mobile-codex/relay dev",
    "dev:mobile": "pnpm --filter @mobile-codex/mobile dev",
    "dev:broker": "pnpm --filter @mobile-codex/relay broker:dev",
    "mac:helper": "node scripts/build-mac-input-helper.mjs",
    "mac:relay-app": "node scripts/build-mac-relay-app.mjs",
    "mac:package": "pnpm build && pnpm mac:helper && pnpm mac:relay-app",
    "android:setup:mac": "bash scripts/setup-android-tools-mac.sh",
    "android:apk:mac": "bash scripts/build-debug-apk-mac.sh",
    "android:hot-bundle": "node scripts/build-hot-bundle.mjs",
    "test:messages": "node scripts/test-message-reconciliation.mjs",
    "test:codex-executable": "pnpm --filter @mobile-codex/relay codex-executable:smoke",
    "dev:relay:mac": "pnpm mac:helper && MOBILE_CODEX_HOST=${MOBILE_CODEX_HOST:-0.0.0.0} MOBILE_CODEX_PORT=${MOBILE_CODEX_PORT:-8787} MOBILE_CODEX_TOKEN=${MOBILE_CODEX_TOKEN:?Set MOBILE_CODEX_TOKEN to a strong random value} pnpm dev:relay",
    "build": "pnpm --filter @mobile-codex/relay build && pnpm --filter @mobile-codex/mobile build",
    "smoke": "pnpm --filter @mobile-codex/relay smoke",
    "typecheck": "pnpm --filter @mobile-codex/relay typecheck && pnpm --filter @mobile-codex/mobile typecheck",
    "test:transport": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/transport.test.mjs",
    "test:correctness": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/correctness.test.mjs",
    "test:mobile": "node --test scripts/test-mobile-connection.mjs scripts/test-mobile-profiles.mjs scripts/test-mobile-voice.mjs scripts/test-mobile-input-transitions.mjs scripts/test-mobile-reliability.mjs scripts/test-mobile-diagnostics.mjs",
    "test:voice": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/voice.test.mjs scripts/test-mobile-voice.mjs",
    "test:hot-update": "node scripts/test-hot-update-paths.mjs && node --test scripts/test-hot-bundle.mjs",
    "test:apk-update": "node --test scripts/test-apk-update.mjs",
    "test:performance": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/performance.test.mjs",
    "test:availability": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/availability.test.mjs",
    "test:gateway": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/agentGateway.test.mjs",
    "probe:gateway": "pnpm --filter @mobile-codex/relay gateway:probe",
    "test:user-input": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/userInput.test.mjs",
    "test:desktop-native": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/desktopNativeControl.test.mjs apps/relay/tests/desktopMessageQueue.test.mjs",
    "test:desktop-approvals": "pnpm --filter @mobile-codex/relay build && node --test apps/relay/tests/desktopApprovals.test.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:managed-gateway": "pnpm --filter @mobile-codex/relay build && pnpm build:plugin && node --test --test-timeout=15000 apps/relay/tests/managedGateway.test.mjs apps/relay/tests/macGatewayService.test.mjs",
    "test:opencode": "pnpm --filter @mobile-codex/relay build && node --test --test-timeout=12000 apps/relay/tests/openCode.test.mjs",
    "test:claude": "pnpm --filter @mobile-codex/relay build && node --test --test-timeout=12000 apps/relay/tests/claude.test.mjs",
    "test:deepseek": "pnpm --filter @mobile-codex/relay build && node --test --test-timeout=12000 apps/relay/tests/deepSeek.test.mjs apps/relay/tests/deepSeekHistory.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "verify": "node scripts/verify.mjs",
    "verify:android": "node scripts/verify-android.mjs",
    "verify:all": "node scripts/verify.mjs --android",
    "test:verification": "node --test scripts/test-verification.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@10.20.0"
}
