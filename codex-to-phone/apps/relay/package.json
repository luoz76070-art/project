{
  "name": "@mobile-codex/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "broker:dev": "tsx src/brokerServer.ts",
    "broker:start": "node dist/brokerServer.js",
    "tunnel:start": "node dist/remoteTunnelClient.js",
